+    /// Overlapping scales for the plain red and black coats. Each scale is a disc on an
+    /// offset lattice; the disc nearest the head wins a pixel, so only each scale's
+    /// crescent shows, with its free edge toward the tail, as on a real koi. Scales
+    /// brighten toward that edge and vary a little from one to the next.
+    fn select_scaled_paint(
+        &self,
+        along_fraction: f64,
+        lateral_fraction: f64,
+        body_length_pixels: f64,
+        half_width_pixels: f64,
+        dither_threshold: f64,
+    ) -> CoatPaint {
+        const SCALE_SPAN: Range<f64> = 0.11..0.93;
+        // White rims thin out by dithering across these lengths of the body.
+        const HEAD_FADE_FRACTION: f64 = 0.09;
+        const TAIL_FADE_FRACTION: f64 = 0.24;
+        // White rims stop short of the edge, which paints the ramp's first shade.
+        const LATERAL_LIMIT: f64 = 0.84;
+        const COLUMN_PIXELS: f64 = 5.6;
+        const ROW_PIXELS: f64 = 4.6;
+        const SCALE_RADIUS_PIXELS: f64 = 4.4;
+        const RIM_PIXELS: f64 = 0.92;
+        const SCALE_VARIATION: f64 = 0.2;
+        const EDGE_BRIGHTENING: f64 = 0.1;
+        let ground_ramp = self.koi_body.select_ground_ramp();
+        if !SCALE_SPAN.contains(&along_fraction) || lateral_fraction.abs() > LATERAL_LIMIT {
+            return CoatPaint::plain(ground_ramp);
+        }
+        let along_pixels = along_fraction * body_length_pixels;
+        let lateral_pixels = lateral_fraction * half_width_pixels;
+        let nearest_row = (lateral_pixels / ROW_PIXELS).round() as i64;
+        let mut owner: Option<(f64, f64, i64, i64)> = None;
+        for row in nearest_row - 1..=nearest_row + 1 {
+            let row_offset = row.rem_euclid(2) as f64 * 0.5;
+            let nearest_column = (along_pixels / COLUMN_PIXELS - row_offset).floor() as i64;
+            for column in nearest_column - 1..=nearest_column + 2 {
+                let center_along = (column as f64 + row_offset) * COLUMN_PIXELS;
+                let center_lateral = row as f64 * ROW_PIXELS;
+                let distance = (along_pixels - center_along).hypot(lateral_pixels - center_lateral);
+                let is_nearer_head = owner.is_none_or(|(owner_along, ..)| center_along < owner_along);
+                if distance < SCALE_RADIUS_PIXELS && is_nearer_head {
+                    owner = Some((center_along, distance, column, row));
+                }
+            }
+        }
+        let Some((center_along, distance, column, row)) = owner else {
+            return CoatPaint::plain(ground_ramp);
+        };
+        let toward_tail = (along_pixels - center_along) / SCALE_RADIUS_PIXELS;
+        let rim_strength = ((along_fraction - SCALE_SPAN.start) / HEAD_FADE_FRACTION)
+            .min((SCALE_SPAN.end - along_fraction) / TAIL_FADE_FRACTION)
+            .clamp(0.0, 1.0);
+        if distance > SCALE_RADIUS_PIXELS - RIM_PIXELS
+            && toward_tail > 0.0
+            && dither_threshold < rim_strength
+        {
+            return CoatPaint::plain(&SCALE_RIM_RAMP);
+        }
+        let scale_tone = hash_lattice_point(
+            self.identity_seed ^ self.koi_body as u64,
+            column,
+            row,
+        ) - 0.5;
+        CoatPaint {
+            brightness_shift: SCALE_VARIATION * scale_tone + EDGE_BRIGHTENING * toward_tail,
+            ..CoatPaint::plain(ground_ramp)
+        }
+    }
+
     /// The current streak fills a dithered share of the fin rims and tips with the
     /// body's streak color. Elsewhere, a fin-root tint is a language color, unless it
     /// matches the plain fins and so never shows.
